<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <LangVersion>latest</LangVersion>

    <Title>Editor Mode</Title>
    <Product>Editor Mode</Product>
    <Authors>NewbieElton</Authors>
    <Company>NewbieElton</Company>
    <Description>A Blasphemous 1 mod that adds an in-game editor mode to tweak level layout on the spot.</Description>
    <Version>0.1.0</Version>

    <TargetName>EditorMode</TargetName>
    <DeployToGame Condition="'$(DeployToGame)' == ''">false</DeployToGame>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <DocumentationFile>bin\$(Configuration)\$(TargetName).xml</DocumentationFile>
    <RepositoryUrl>https://github.com/Example</RepositoryUrl>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Blasphemous.Framework.Levels" Version="0.2.0" />
    <PackageReference Include="Blasphemous.Framework.UI" Version="0.2.0" />
    <PackageReference Include="Blasphemous.GameLibs" Version="4.0.67" />
    <PackageReference Include="Blasphemous.ModdingAPI" Version="3.0.1" />
    <PackageReference Include="UnityEngine.Modules" Version="2017.4.40" IncludeAssets="compile" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="HarmonyPatches\" />
    <Folder Include="Extensions\" />
  </ItemGroup>

  <Target Name="Development" AfterTargets="PostBuildEvent">

    <!-- Validate explicit deployment before packaging -->
    <PropertyGroup>
      <DevFolderIsDirectory>$([System.IO.Directory]::Exists('$(DevFolder)'))</DevFolderIsDirectory>
    </PropertyGroup>
    <Error Condition="'$(DeployToGame)' == 'true' and '$(DevFolderIsDirectory)' != 'True'" Text="DeployToGame=true requires DevFolder to name an existing directory. Current DevFolder: '$(DevFolder)'." />

    <!-- Get plugin & resources -->
    <ItemGroup>
      <PluginDll Include="$(TargetPath)" />
      <Resources Include="$(MSBuildProjectDirectory)\..\resources\**\*.*" />
    </ItemGroup>

    <!-- Get packaging directories -->
    <PropertyGroup>
      <RepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..'))</RepositoryRoot>
      <PackageStagingFolder>$(IntermediateOutputPath)package\</PackageStagingFolder>
      <PublishFolder>$(RepositoryRoot)\publish</PublishFolder>
    </PropertyGroup>

    <!-- Stage package content away from game and publish directories -->
    <RemoveDir Directories="$(PackageStagingFolder)" />
    <MakeDir Directories="$(PackageStagingFolder);$(PublishFolder)" />
    <Copy SourceFiles="@(Resources)" DestinationFolder="$(PackageStagingFolder)\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(PluginDll)" DestinationFolder="$(PackageStagingFolder)\plugins" SkipUnchangedFiles="true" />
    <ZipDirectory SourceDirectory="$(PackageStagingFolder)" DestinationFile="$(PublishFolder)\$(TargetName).zip" Overwrite="true" />

    <!-- Deploy only through the explicit opt-in -->
    <Copy SourceFiles="@(Resources)" DestinationFolder="$(DevFolder)\%(RecursiveDir)" SkipUnchangedFiles="true" Condition="'$(DeployToGame)' == 'true'" />
    <Copy SourceFiles="@(PluginDll)" DestinationFolder="$(DevFolder)\plugins" SkipUnchangedFiles="true" Condition="'$(DeployToGame)' == 'true'" />

  </Target>

  <Target Name="AddGeneratedFile" BeforeTargets="BeforeCompile;CoreCompile" Inputs="$(MSBuildAllProjects)" Outputs="$(IntermediateOutputPath)GeneratedFile.cs">

    <!-- Create ModInfo class from relevant data -->
    <PropertyGroup>
      <GeneratedText>
        <![CDATA[ namespace $(RootNamespace) { internal static class ModInfo { public const string MOD_ID = "$(AssemblyName)"%3B public const string MOD_NAME = "$(Product)"%3B public const string MOD_AUTHOR = "$(Company)"%3B public const string MOD_VERSION = "$(Version)"%3B } } ]]>
      </GeneratedText>
      <GeneratedFilePath>$(IntermediateOutputPath)ModInfo.cs</GeneratedFilePath>
    </PropertyGroup>

    <!-- Write ModInfo data to intermediate output -->
    <ItemGroup>
      <Compile Include="$(GeneratedFilePath)" />
      <FileWrites Include="$(GeneratedFilePath)" />
    </ItemGroup>
    <WriteLinesToFile Lines="$(GeneratedText)" File="$(GeneratedFilePath)" WriteOnlyWhenDifferent="true" Overwrite="true" />

  </Target>
  
</Project>

